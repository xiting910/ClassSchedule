<UserControl x:Class="ClassSchedule.UI.Shared.Views.ConfirmView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             x:DataType="vm:ConfirmViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Bottom"
             Margin="12,0,12,16">

  <Border Background="{DynamicResource CardBackgroundBrush}"
          CornerRadius="{StaticResource CardCornerRadius}"
          Padding="{StaticResource CardPadding}"
          Opacity="{Binding Opacity}">

    <Border.Transitions>
      <Transitions>
        <DoubleTransition Duration="0:0:0.2" Property="Opacity"/>
      </Transitions>
    </Border.Transitions>

    <Border.RenderTransform>
      <TranslateTransform Y="{Binding OffsetY}">
        <TranslateTransform.Transitions>
          <Transitions>
            <DoubleTransition Duration="0:0:0.2" Easing="CubicEaseOut" Property="Y"/>
          </Transitions>
        </TranslateTransform.Transitions>
      </TranslateTransform>
    </Border.RenderTransform>

    <StackPanel Spacing="12">
      <TextBlock FontSize="16"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleForegroundBrush}"
                 Text="{Binding Title}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"/>
      <TextBlock FontSize="13"
                 Text="{Binding Message}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"/>
      <UniformGrid ColumnSpacing="12" Rows="1">
        <Button Background="{DynamicResource AccentButtonBackgroundBrush}"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="{DynamicResource AccentButtonForegroundBrush}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
        <Button Background="{DynamicResource DangerButtonBackgroundBrush}"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                Foreground="{DynamicResource DangerButtonForegroundBrush}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
      </UniformGrid>
    </StackPanel>

  </Border>

</UserControl>
