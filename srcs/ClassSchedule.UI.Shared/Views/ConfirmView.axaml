<UserControl x:Class="ClassSchedule.UI.Shared.Views.ConfirmView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             x:DataType="vm:ConfirmViewModel">

  <!-- 卡片的外观 (背景, 圆角, 内边距) 由 ShellView 的卡片容器负责, 这里只放内容 -->
  <StackPanel MaxWidth="360" Spacing="12">
    <TextBlock FontSize="16"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TitleForegroundBrush}"
               Text="{Binding Title}"
               TextWrapping="Wrap"/>
    <TextBlock FontSize="13" Text="{Binding Message}" TextWrapping="Wrap"/>
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button Command="{Binding CancelCommand}" Content="取消"/>
      <Button Background="{DynamicResource DangerButtonBackgroundBrush}"
              Command="{Binding ConfirmCommand}"
              Content="{Binding ConfirmText}"
              Foreground="{DynamicResource DangerButtonForegroundBrush}"/>
    </StackPanel>
  </StackPanel>

</UserControl>
