<UserControl x:Class="ClassSchedule.UI.Shared.Views.ShellView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             x:DataType="vm:ShellViewModel"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

  <Panel>

    <!-- Tab 内容区: 三个占位页, 后续阶段各自替换成真正的页面 -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Bottom">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
      </TabControl.Styles>

      <TabItem Header="课表">
        <!-- 临时入口 -->
        <Button Command="{Binding OpenTimetableListCommand}"
                Content="课表列表"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
      </TabItem>

      <TabItem Header="课程">
        <TextBlock HorizontalAlignment="Center" Text="课程" VerticalAlignment="Center"/>
      </TabItem>

      <TabItem Header="设置">
        <TextBlock HorizontalAlignment="Center" Text="设置" VerticalAlignment="Center"/>
      </TabItem>
    </TabControl>

    <!-- 导航栈覆盖层: 页面自带不透明背景, 这里不叠底色 -->
    <ContentControl Content="{Binding NavigationStack.CurrentPage}"
                    IsVisible="{Binding NavigationStack.HasPage}"/>

    <!-- 共用遮罩: 盖在导航栈覆盖层之上, 点击取消浮层 -->
    <Border Background="{DynamicResource ConfirmMaskBrush}"
            IsVisible="{Binding OverlayHost.HasOverlay}"
            Opacity="{Binding OverlayHost.MaskOpacity}"
            PointerPressed="OnMaskPressed">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Duration="0:0:0.2" Property="Opacity"/>
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- 浮层: 盖在遮罩之上 -->
    <ContentControl Content="{Binding OverlayHost.Current}" IsVisible="{Binding OverlayHost.HasOverlay}"/>

    <!-- 全局提示: 永远最上层 -->
    <ContentControl Content="{Binding Toast}"/>

  </Panel>

</UserControl>
