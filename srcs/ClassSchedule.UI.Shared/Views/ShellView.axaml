<UserControl x:Class="ClassSchedule.UI.Shared.Views.ShellView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ClassSchedule.UI.Shared.Views"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             x:DataType="vm:ShellViewModel"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

  <Panel>

    <!-- Tab 内容区: 三个占位页, 后续阶段各自替换成真正的页面 -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Bottom">
      <TabItem Header="课表">
        <TextBlock HorizontalAlignment="Center" Text="课表" VerticalAlignment="Center"/>
      </TabItem>

      <TabItem Header="课程">
        <TextBlock HorizontalAlignment="Center" Text="课程" VerticalAlignment="Center"/>
      </TabItem>

      <TabItem Header="设置">
        <TextBlock HorizontalAlignment="Center" Text="设置" VerticalAlignment="Center"/>
      </TabItem>
    </TabControl>

    <!-- 导航栈覆盖层: 页面自带不透明背景, 这里不叠底色 -->
    <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding HasPage}"/>

    <!-- 共用遮罩: 必须盖在导航栈覆盖层之上, 点击等同于取消 -->
    <Border Background="{DynamicResource ConfirmMaskBrush}"
            IsVisible="{Binding IsConfirmVisible}"
            Opacity="{Binding ConfirmOpacity}"
            PointerPressed="OnMaskPressed">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Duration="0:0:0.2" Property="Opacity"/>
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- 确认卡片: 从下方 16px 上浮并淡入, 内容由 ConfirmView 提供 -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{DynamicResource CardCornerRadius}"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsConfirmVisible}"
            Opacity="{Binding ConfirmOpacity}"
            Padding="{DynamicResource CardPadding}"
            VerticalAlignment="Center">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Duration="0:0:0.2" Property="Opacity"/>
        </Transitions>
      </Border.Transitions>

      <Border.RenderTransform>
        <TranslateTransform Y="{Binding ConfirmOffsetY}">
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Duration="0:0:0.2" Easing="CubicEaseOut" Property="Y"/>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Border.RenderTransform>

      <ContentControl Content="{Binding Confirm}"/>
    </Border>

    <!-- 全局提示: 永远最上层 -->
    <views:ToastView DataContext="{Binding Toast}"/>

  </Panel>

</UserControl>
