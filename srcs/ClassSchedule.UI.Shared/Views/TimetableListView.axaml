<UserControl x:Class="ClassSchedule.UI.Shared.Views.TimetableListView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ClassSchedule.UI.Shared.Models"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             x:DataType="vm:TimetableListViewModel">

  <Grid Background="{DynamicResource PageBackgroundBrush}" RowDefinitions="Auto,*">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="16">

      <Button Grid.Column="0"
              Background="Transparent"
              BorderThickness="0"
              Command="{Binding GoBackCommand}"
              MinHeight="44"
              MinWidth="44">

        <Button.Styles>
          <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
          <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </Button.Styles>

        <Path Data="M15,4 L7,12 L15,20"
              HorizontalAlignment="Center"
              Stroke="{DynamicResource SecondaryTextBrush}"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              StrokeThickness="2"
              VerticalAlignment="Center"/>
      </Button>

      <TextBlock Grid.Column="1"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleForegroundBrush}"
                 Text="课表列表"
                 VerticalAlignment="Center"/>

      <Button Grid.Column="2"
              Background="{DynamicResource PrimaryButtonBackgroundBrush}"
              Command="{Binding OpenCreateTimetableCommand}"
              Content="新建课表"
              Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
              VerticalAlignment="Center"/>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="16,0,16,16" Spacing="12">

        <!-- 行列表: 点名称区切换当前课表, 右侧按钮改名或删除 -->
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:TimetableListItem">
              <Border Background="{DynamicResource CardBackgroundBrush}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Padding="{StaticResource CardPadding}">

                <Grid ColumnDefinitions="*,Auto">

                  <!-- 常态: 这块区域铺满按钮左侧, 点它切换当前课表 -->
                  <StackPanel Grid.Column="0"
                              Background="Transparent"
                              IsVisible="{Binding !IsRenaming}"
                              Spacing="2"
                              Tapped="OnSelectTapped"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontSize="15"
                                 Text="{Binding Name}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center"/>
                      <Border Background="{DynamicResource StateChipBackgroundBrush}"
                              CornerRadius="9"
                              IsVisible="{Binding IsCurrent}"
                              Padding="8,1"
                              VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource StateChipForegroundBrush}"
                                   Text="当前"/>
                      </Border>
                    </StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding RangeText}"/>
                  </StackPanel>

                  <!-- 重命名态: 就地编辑名称 -->
                  <TextBox Grid.Column="0"
                           IsVisible="{Binding IsRenaming}"
                           PlaceholderText="课表名称"
                           Text="{Binding EditingName}"
                           VerticalAlignment="Center"/>

                  <!-- Margin 是给输入框留的间隔, 否则 TextBox 会贴着「确定」 -->
                  <StackPanel Grid.Column="1"
                              Margin="12,0,0,0"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <Button Background="{DynamicResource InfoButtonBackgroundBrush}"
                            Click="OnRenameClick"
                            Content="重命名"
                            Foreground="{DynamicResource InfoButtonForegroundBrush}"
                            IsVisible="{Binding !IsRenaming}"/>
                    <Button Background="{DynamicResource DangerButtonBackgroundBrush}"
                            Click="OnDeleteClick"
                            Content="删除"
                            Foreground="{DynamicResource DangerButtonForegroundBrush}"
                            IsVisible="{Binding !IsRenaming}"/>
                    <Button Background="{DynamicResource SuccessButtonBackgroundBrush}"
                            Click="OnCommitRenameClick"
                            Content="确定"
                            Foreground="{DynamicResource SuccessButtonForegroundBrush}"
                            IsVisible="{Binding IsRenaming}"/>
                    <Button Background="{DynamicResource AccentButtonBackgroundBrush}"
                            Click="OnCancelRenameClick"
                            Content="取消"
                            Foreground="{DynamicResource AccentButtonForegroundBrush}"
                            IsVisible="{Binding IsRenaming}"/>
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空态: 列表为空时显示提示 -->
        <StackPanel HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,48,0,0"
                    Spacing="12">
          <TextBlock FontSize="15"
                     HorizontalAlignment="Center"
                     Text="还没有课表"/>
          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                     HorizontalAlignment="Center"
                     Text="点右上角的「新建课表」创建一个课表"
                     TextWrapping="Wrap"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
