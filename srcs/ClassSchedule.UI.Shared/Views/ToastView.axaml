<UserControl x:Class="ClassSchedule.UI.Shared.Views.ToastView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassSchedule.UI.Shared.ViewModels"
             xmlns:models="using:ClassSchedule.UI.Shared.Models"
             x:DataType="vm:ToastViewModel"
             IsVisible="{Binding HasItems}"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,16,0,0">

  <!-- 多条提示纵向堆叠, 最新条目在上方, 每条独立计时 -->
  <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" HorizontalAlignment="Center"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:Toast">
        <Border Background="{DynamicResource ToastBackgroundBrush}"
                BoxShadow="0 4 12 0 #33000000"
                CornerRadius="{StaticResource CardCornerRadius}"
                Cursor="Hand"
                Opacity="{Binding EnterOpacity}"
                Padding="{StaticResource CardPadding}"
                Tapped="OnToastTapped">

          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
          </Border.Transitions>

          <Border.RenderTransform>
            <TranslateTransform Y="{Binding EnterOffset}">
              <TranslateTransform.Transitions>
                <Transitions>
                  <DoubleTransition Property="Y" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
              </TranslateTransform.Transitions>
            </TranslateTransform>
          </Border.RenderTransform>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Message}" Foreground="White" FontSize="13" TextWrapping="Wrap" />

            <!-- 剩余时间进度条: 前景条按剩余比例从满宽缩至零, 线性过渡补间保证平滑缩短 -->
            <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF">
              <Border Background="{DynamicResource ToastProgressBrush}"
                      CornerRadius="1.5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                <Border.RenderTransform>
                  <ScaleTransform ScaleX="{Binding Progress}" ScaleY="1">
                    <ScaleTransform.Transitions>
                      <Transitions>
                        <!-- 过渡时长略大于刷新间隔, 每次进度更新都连续补间而非跳变 -->
                        <DoubleTransition Property="ScaleX" Duration="0:0:0.06"/>
                      </Transitions>
                    </ScaleTransform.Transitions>
                  </ScaleTransform>
                </Border.RenderTransform>

                <Border.RenderTransformOrigin>0,0.5</Border.RenderTransformOrigin>
              </Border>
            </Border>
          </StackPanel>

        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
